---
import { campusAreas } from '../data/campus';

const orderedAreas = [...campusAreas].sort((a, b) => a.navOrder - b.navOrder);
---

<section class="map-section shell" aria-labelledby="map-title">
  <div class="map-intro">
    <h2 id="map-title">Explora Campus YaskCode</h2>
    <p>Selecciona un espacio del mapa. En pantallas pequeñas, desplázate horizontalmente para recorrerlo.</p>
  </div>

  <div class="map-scroll" role="region" aria-label="Mapa interactivo del Campus YaskCode" tabindex="0">
    <!-- Canvas maestro intacto: todas las capas comparten las dimensiones fuente 1672 × 941. -->
    <div class="map-frame">
      <img
        src="/images/campus-yaskcode.png"
        alt="Vista general del Campus YaskCode con edificios académicos, comunitarios y tecnológicos."
        class="campus-image"
        width="1672"
        height="941"
      />

      <!--
        Un único viewBox hace que los polígonos sean reproducibles y responsivos sin alterar la imagen.
        Para futuros ajustes, registra los puntos en src/data/campus.ts usando siempre el canvas 1672 × 941.
      -->
      <svg class="campus-interactions" viewBox="0 0 1672 941" aria-labelledby="destinations-title">
        <title id="destinations-title">Quince destinos interactivos del Campus YaskCode</title>
        {orderedAreas.map((area) => {
          const hasExternalUrl = Boolean(area.interactionUrl);
          const href = area.interactionUrl ?? `#campus-status-${area.id}`;
          const action = hasExternalUrl ? 'Explorar' : 'Ver información';
          return (
            <a
              href={href}
              target={hasExternalUrl ? '_blank' : undefined}
              rel={hasExternalUrl ? 'noopener noreferrer' : undefined}
              class={`campus-destination campus-destination--${area.category}`}
              aria-label={`${area.name}. ${action}.`}
            >
              <polygon class="destination-hit" points={area.interaction.points} />
              <polygon class="destination-outline" points={area.interaction.points} aria-hidden="true" />
              <g
                class="destination-label"
                transform={`translate(${area.interaction.labelX} ${area.interaction.labelY})`}
                aria-hidden="true"
              >
                <rect class="destination-label-bg" width="292" height="54" rx="12" />
                <text x="16" y="23" class="destination-label-name">{area.shortName}</text>
                <text x="16" y="42" class="destination-label-action">{action}</text>
              </g>
            </a>
          );
        })}
      </svg>
    </div>
  </div>
  <p class="map-help">Usa Tab para recorrer los 15 destinos y Enter para abrir el seleccionado.</p>
</section>
