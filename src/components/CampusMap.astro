---
import { campusAreas } from '../data/campus';
---

<section class="map-section shell" aria-labelledby="map-title">
  <div class="map-intro">
    <h2 id="map-title">Explora Campus YaskCode</h2>
    <p>
      Recorre los espacios de docencia, investigación, innovación y comunidad que
      forman el ecosistema.
    </p>
  </div>

  <div class="map-frame">
    <img
      src="/images/campus-yaskcode.png"
      alt="Ilustración del Campus YaskCode con sus espacios académicos, tecnológicos y comunitarios."
      class="campus-image"
    />
    <div class="hotspot-layer" aria-label="Hotspots del Campus YaskCode">
      {campusAreas.map((area) => (
        <>
        {area.interactionPolygon ? (
          <svg
            class="interaction-svg-layer"
            viewBox="0 0 1672 941"
            preserveAspectRatio="xMidYMid slice"
            role="presentation"
            aria-hidden="false"
          >
            <a
              href={area.interactionUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="interaction-hit-link"
              aria-label={area.name}
            >
              <polygon
                id={`${area.id}-hit-area`}
                class="interaction-hit-area"
                points={area.interactionPolygon.points}
              />
            </a>
            <g class="academy-callout" aria-hidden="true">
              <path class="academy-callout-tail" d="M148,281 L172,281 L160,301 Z" />
              <rect class="academy-callout-bg" x="48" y="213" width="212" height="70" rx="17" />
              <text class="academy-callout-title" x="64" y="244">YaskCode Academy</text>
              <text class="academy-callout-subtitle" x="64" y="266">Explorar</text>
            </g>
          </svg>
        ) : area.hotspot?.x !== undefined && area.hotspot?.y !== undefined && (
          <div
            class="hotspot-item"
            style={`left: ${area.hotspot.x}%; top: ${area.hotspot.y}%;`}
          >
            {area.interactionUrl ? (
              <a
                href={area.interactionUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hotspot"
                aria-label={area.name}
              >
                <span class="hotspot-label">
                  {area.shortName ?? area.name}
                  <span class="hotspot-label-action">Explorar</span>
                </span>
              </a>
            ) : (
              <button type="button" class="hotspot" aria-label={area.name}>
                <span class="hotspot-label">
                  {area.shortName ?? area.name}
                  <span class="hotspot-label-action">Próximamente</span>
                </span>
              </button>
            )}
          </div>
        )}
          {area.overlay && !area.interactionPolygon && (
            <div
              class="overlay-item"
              style={`left: ${(area.overlay.x ?? area.hotspot?.x)}%; top: ${(area.overlay.y ?? area.hotspot?.y)}%;`}
            >
              <img
                src={area.overlay.src}
                alt={area.overlay.alt}
                class="hotspot-overlay"
                aria-hidden="true"
                style={`
                  --overlay-width: ${area.overlay.width || 'min(15rem, 24vw)'};
                  --overlay-offset-x: ${area.overlay.offsetX || '0'};
                  --overlay-offset-y: ${area.overlay.offsetY || '0'};
                  --overlay-scale: ${area.overlay.scale || '0.98'};
                  --overlay-origin: ${area.overlay.origin || 'bottom center'};
                  ${area.overlay.zIndex ? `z-index: ${area.overlay.zIndex};` : ''}
                `}
              />
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>