<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Campus YaskCode, inicio">
      <span class="brand-mark" aria-hidden="true">Y</span>
      <span>Campus YaskCode</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="#campus">Campus</a>
      <a href="#about">Sobre el campus</a>
      <a href="#contact">Contacto</a>
      <a href="#english-guide" lang="en">English guide</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'));
    const sections = links.flatMap((link) => {
      const section = document.getElementById(link.hash.slice(1));
      return section ? [{ link, section }] : [];
    });
    let scheduled = false;
    function updateActive() {
      scheduled = false;
      const boundary = (header?.getBoundingClientRect().bottom ?? 0) + 24;
      // Compare viewport coordinates: offsetTop can use different offset parents.
      const ordered = [...sections].sort((a, b) =>
        a.section.getBoundingClientRect().top - b.section.getBoundingClientRect().top);
      let current = ordered[0];
      for (const item of ordered) {
        if (item.section.getBoundingClientRect().top <= boundary) current = item;
      }
      // A short final section cannot always reach the sticky header.
      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      const last = ordered[ordered.length - 1];
      if (atBottom && last && last.section.getBoundingClientRect().top < window.innerHeight) current = last;
      for (const item of sections) {
        if (item === current) item.link.setAttribute('aria-current', 'location');
        else item.link.removeAttribute('aria-current');
      }
    }
    function scheduleUpdate() {
      if (!scheduled) { scheduled = true; requestAnimationFrame(updateActive); }
    }
    const observer = new ResizeObserver(() => {
      document.documentElement.style.setProperty('--campus-header-height', `${header.getBoundingClientRect().height}px`);
      scheduleUpdate();
    });
    observer.observe(header);
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('load', scheduleUpdate);
    updateActive();
  }
</script>
