---
import { campusAreas } from '../data/campus';
import { campusSceneNodes } from '../data/campusScene';

const areaById = new Map(campusAreas.map((area) => [area.id, area]));

const sceneDestinations = campusSceneNodes
  .map((node) => {
    const area = areaById.get(node.id);
    if (!area) return undefined;

    return {
      area,
      node,
      href: area.interactionUrl ?? node.fallbackHref ?? '#campus'
    };
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .sort((a, b) => a.area.navOrder - b.area.navOrder);
---

<section class="campus-scene shell" aria-labelledby="scene-title">
  <div class="scene-intro">
    <h2 id="scene-title">Explora la nueva ciudad académica de Campus YaskCode</h2>
    <p>
      Recorre sus espacios con teclado o puntero. Cada destino abre una ruta de
      aprendizaje, investigación o comunidad.
    </p>
  </div>

  <div class="scene-stage" role="region" aria-label="Escena interactiva del Campus YaskCode">
    <img
      src="/images/campus-tropical-innovation-bg-v1.png"
      alt=""
      aria-hidden="true"
      class="scene-bg"
      loading="eager"
      decoding="async"
    />

    <div class="scene-nodes">
      {sceneDestinations.map(({ area, node, href }) => (
        <a
          href={href}
          class={`scene-node ${node.kind === 'building' ? 'scene-node-building' : 'scene-node-vector'}`}
          style={`--x: ${node.x}%; --y: ${node.y}%; --node-width: ${node.width}; --layer: ${node.layer};`}
          aria-label={`${area.name}. ${area.description}. Explorar destino.`}
          target={area.interactionUrl ? '_blank' : undefined}
          rel={area.interactionUrl ? 'noopener noreferrer' : undefined}
        >
          <span class="scene-node-hit" aria-hidden="true"></span>

          {node.kind === 'building' ? (
            <img src={node.imageSrc} alt={node.imageAlt} class="scene-building" loading="lazy" decoding="async" />
          ) : (
            <span class="scene-vector-wrap" aria-hidden="true">
              <span class={`scene-vector scene-vector-${node.vectorKind ?? 'plaza'}`}>
                <svg viewBox="0 0 100 100" focusable="false" aria-hidden="true">
                {node.vectorKind === 'gate' ? (
                  <>
                    <path d="M12 74 L24 74 L24 40 L37 40 L37 74 L63 74 L63 40 L76 40 L76 74 L88 74" />
                    <path d="M18 40 Q50 10 82 40" />
                    <path d="M50 26 L50 74" />
                  </>
                ) : (
                  <>
                    <circle cx="50" cy="50" r="30" />
                    <circle cx="50" cy="50" r="12" />
                    <path d="M50 18 L50 2" />
                    <path d="M82 50 L98 50" />
                    <path d="M50 82 L50 98" />
                    <path d="M18 50 L2 50" />
                  </>
                )}
                </svg>
              </span>
              <span class="scene-vector-caption">
                {node.id === 'entrada-principal' ? 'Entrada' : 'Conexiones'}
              </span>
            </span>
          )}

          <span class="scene-node-pill">
            <strong>{area.shortName ?? area.name}</strong>
            <span>EXPLORAR</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
